# Smart Parking Reservation & Management System (Code2Web 2026)
# Configuration Template - Do not put actual production credentials in this example file.

APP_NAME="ParkPulse Smart Parking"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/smart%20parking

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_parking_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security & Session
SESSION_LIFETIME=7200
CSRF_SECRET_KEY=replace_with_a_secure_random_64_char_hex_key_for_production
QR_SECRET_SALT=replace_with_a_secure_salt_for_qr_verification_tokens

# Feature Flags
ENABLE_SIMULATED_PAYMENTS=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Razorpay Test Mode Gateway Configuration
RAZORPAY_TEST_MODE=true
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
PAYMENT_SECRET_KEY=parkpulse_sec_gateway_salt_2026_india
UPI_MERCHANT_VPA=parkpulse.pay@icici
UPI_MERCHANT_NAME="ParkPulse Smart Parking"
